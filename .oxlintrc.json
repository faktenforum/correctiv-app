{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // NOTE: this file is JSONC — comments are supported and are the only place
  // rule decisions are recorded. Do not silence a rule without saying why.
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "vue",
    "react",
    "jsx-a11y",
    "import",
    "promise",
    "jest"
  ],
  // react-perf is deliberately NOT enabled. Its jsx-no-new-{object,function,array}-as-prop
  // rules flagged 37 sites in apps/mobile, all of them inline props that the
  // React Compiler memoizes automatically — the app turns it on via
  // app.json "experiments": { "reactCompiler": true }. Enabling the plugin would
  // mean hand-memoizing what the compiler already does, i.e. fighting the toolchain.
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "env": {
    "es2022": true,
    "browser": true
  },
  "globals": {
    "__ANDROID__": "readonly",
    "__IOS__": "readonly",
    "__VISIONOS__": "readonly",
    "__DEV__": "readonly",
    "java": "readonly",
    "android": "readonly",
    "androidx": "readonly",
    "NSObject": "readonly",
    "UIApplication": "readonly"
  },
  "ignorePatterns": [
    "media/**",
    "packages/app-core/test/__fixtures__/**",
    "apps/mobile/__fixtures__/**"
  ],
  "rules": {
    "no-console": "off",

    "no-underscore-dangle": "off",

    // Suggests the ES2023 toSorted(). The core is meant to run on any runtime,
    // including ones without it, so the in-place sort stays.
    "unicorn/no-array-sort": "off",

    "oxc/no-map-spread": "warn",

    // Obsolete since React 17's automatic JSX runtime: JSX no longer expands to
    // React.createElement, so React need not be in scope. apps/mobile is on
    // React 19 and babel-preset-expo's automatic runtime. Left on, this produced
    // 132 false positives in one pass.
    "react/react-in-jsx-scope": "off",

    // Assumes `style` is always a style object. expo-status-bar's StatusBar takes
    // a StatusBarStyle string union ("dark" | "light" | "auto"), so <StatusBar
    // style="dark" /> is correct and the rule cannot tell the difference.
    "react/style-prop-object": "off"
  },
  "overrides": [
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "typescript/triple-slash-reference": "off"
      }
    },
    {
      // The generator scripts fetch upstream resources one at a time on purpose —
      // sequential requests are gentler on correctiv.org than a burst.
      "files": ["apps/mobile/scripts/**"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      // Side-effect-only imports are how Expo Router and the styling engine are
      // wired up: `import 'expo-router/entry'` registers the root component,
      // `import '@/global.css'` is the CSS entry Uniwind's Metro transform reads.
      // There is nothing to assign.
      "files": ["apps/mobile/index.js", "apps/mobile/src/app/_layout.tsx"],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      // `allow-scripts` + `allow-same-origin` is the combination the rule warns
      // about, because for a SAME-ORIGIN frame it lets the document remove its own
      // sandbox. This frame is cross-origin (youtube-nocookie.com), so
      // `allow-same-origin` keeps YouTube's origin — not ours — and there is
      // nothing to escape into. Dropping it instead breaks the player: it needs
      // storage access to initialise. What the sandbox still buys us is the part
      // that matters here — the embed cannot navigate the top-level page.
      "files": ["apps/mobile/src/components/media/VideoFrame.web.tsx"],
      "rules": {
        "react/iframe-missing-sandbox": "off"
      }
    },
    {
      // The search screen exists for nothing but searching, and it is only ever
      // reached by an explicit tap on the search entry — so focusing the field is
      // what the user just asked for, and it saves a second tap plus a keyboard
      // animation. jsx-a11y's concern (focus stolen on page load, context lost)
      // applies to web forms that happen to contain an input, not to a pushed
      // search route. The field carries an accessibilityLabel.
      "files": ["apps/mobile/src/app/suche.tsx"],
      "rules": {
        "jsx-a11y/no-autofocus": "off"
      }
    }
  ]
}

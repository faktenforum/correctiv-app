{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "printWidth": 100,
  "trailingComma": "all",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "bracketSpacing": true,
  "arrowParens": "always",
  "vueIndentScriptAndStyle": false,
  "ignorePatterns": [
    "docs/**",
    "media/**",
    "apps/mobile/App_Resources/**",
    ".github/**",
    "**/*.md",
    "**/*.scss",
    "apps/mobile/src/assets/**",
    "apps/mobile/src/fonts/**",
    "packages/app-core/test/__fixtures__/**",
    "apps/mobile-rn/__fixtures__/**",
    "apps/mobile-rn/assets/**",
    "**/*.d.mts",
    "package-lock.json",
    "**/*.generated.*",
    // Vendored design tokens — must stay byte-identical to upstream so a plain diff
    // against a fresh checkout is meaningful, and because theme.css is embedded
    // verbatim into the reader WebView. See tokens/README.md.
    "tokens/**"
  ],
  "sortPackageJson": false
}

{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "tabWidth": 2,
  "printWidth": 100,
  "trailingComma": "all",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "bracketSpacing": true,
  "arrowParens": "always",
  "vueIndentScriptAndStyle": false,
  "ignorePatterns": [
    "media/**",
    ".github/**",
    "**/*.md",
    "**/*.scss",
    "packages/app-core/test/__fixtures__/**",
    "apps/mobile-rn/__fixtures__/**",
    "apps/mobile-rn/assets/**",
    "**/*.d.mts",
    "package-lock.json",
    "**/*.generated.*",
    // Written by `uniwind generate-artifacts`, which has its own formatting and
    // would undo ours on the next run.
    "apps/mobile-rn/uniwind-types.d.ts",
    // Generated by packages/design-tokens; they do not match `*.generated.*`
    // because their names are the import paths a consumer writes.
    "packages/design-tokens/theme.css",
    "packages/design-tokens/theme.standalone.css",
    // Vendored design tokens — must stay byte-identical to upstream so a plain diff
    // against a fresh checkout is meaningful, and because theme.css is embedded
    // verbatim into the reader WebView. See tokens/README.md.
    "tokens/**"
  ],
  "sortPackageJson": false
}

{
  "name": "correctiv-app",
  "description": "CORRECTIV community app \u2014 npm workspace: the platform-free core plus the Expo/React Native app (iOS, Android, web).",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faktenforum/correctiv-app.git"
  },
  "bugs": {
    "url": "https://github.com/faktenforum/correctiv-app/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsx": "^4.22.4",
    "typescript": "~5.8.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch -w @correctiv/app-core",
    "web": "npm run web -w @correctiv/mobile-rn",
    "start": "npm start -w @correctiv/mobile-rn",
    "android": "npm run android -w @correctiv/mobile-rn",
    "ios": "npm run ios -w @correctiv/mobile-rn",
    "build:web": "npm run build:web -w @correctiv/mobile-rn",
    "tokens": "npm run tokens -w @correctiv/design-tokens",
    "fonts": "npm run fonts -w @correctiv/mobile-rn",
    "offline-articles": "npm run offline-articles -w @correctiv/mobile-rn",
    "offline-podcasts": "npm run offline-podcasts -w @correctiv/mobile-rn"
  }
}

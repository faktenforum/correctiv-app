{
  "name": "correctiv-app",
  "description": "CORRECTIV community app — npm workspace root (NativeScript mobile app + platform-free core).",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/faktenforum/correctiv-app.git"
  },
  "bugs": {
    "url": "https://github.com/faktenforum/correctiv-app/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^20.19.43",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "~5.8.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch -w @correctiv/app-core",
    "android": "npm run android -w @correctiv/mobile",
    "ios": "npm run ios -w @correctiv/mobile",
    "dev:android": "npm run dev:android -w @correctiv/mobile",
    "dev:ios": "npm run dev:ios -w @correctiv/mobile",
    "build:android": "npm run build:android -w @correctiv/mobile",
    "build:android:debug": "npm run build:android:debug -w @correctiv/mobile",
    "tokens": "npm run tokens -w @correctiv/mobile",
    "offline-articles": "npm run offline-articles -w @correctiv/mobile",
    "offline-podcasts": "npm run offline-podcasts -w @correctiv/mobile"
  }
}

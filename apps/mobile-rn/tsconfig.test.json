{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "customConditions": null,
    "types": ["node", "jest"]
  },
  // nativewind-env.d.ts is what teaches react-native's components the `className`
  // prop. The main tsconfig lists it; without it here, any test that renders a
  // real component — rather than a bare <Text> — fails on every className in the
  // tree, including in files that typecheck fine for the app itself.
  "include": ["__tests__/**/*.ts", "__tests__/**/*.tsx", "scripts/**/*.mjs", "nativewind-env.d.ts"],
  "exclude": ["node_modules", "android", "ios"]
}

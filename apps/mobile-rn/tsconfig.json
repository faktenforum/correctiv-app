{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      // jest-expo turns these into a moduleNameMapper, where the FIRST match wins
      // with no fallback — so "@/assets/*" has to be reinstated ahead of "@/*"
      // there. See the note in jest.config.js.
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      // Point at the workspace packages' sources directly. Both ship TypeScript,
      // not a build, so without these tsc cannot follow the subpath exports and
      // reports every @correctiv/* import as a missing module. Metro resolves them
      // at runtime through the workspace symlink and each package's exports map.
      "@correctiv/app-core": ["../../packages/app-core/src/index.ts"],
      "@correctiv/app-core/*": ["../../packages/app-core/src/*"],
      "@correctiv/design-tokens": ["../../packages/design-tokens/src/index.ts"],
      "@correctiv/design-tokens/*": ["../../packages/design-tokens/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
  "exclude": ["node_modules", "android", "ios", "__tests__", "scripts"]
}
